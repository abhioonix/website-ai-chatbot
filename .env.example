# ------------------------------------------------------------------
# website-ai-chatbot environment configuration
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ------------------------------------------------------------------

# --- LLM provider (OpenAI-compatible chat completions) --------------
# Groq (free tier, no card required): https://console.groq.com/keys
LLM_API_KEY=your_api_key_here
# Base URL of the OpenAI-compatible endpoint (no trailing slash).
LLM_BASE_URL=https://api.groq.com/openai/v1
# The model identifier exposed by the provider. Any chat model works.
# Free Groq examples: openai/gpt-oss-20b, openai/gpt-oss-120b, qwen/qwen3.8-27b,
#                    allam-2-7b. Change freely — nothing is hard-coded.
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=30

# --- Embeddings (Jina AI — free tier, no credit card) ---------------
# https://jina.ai/embeddings  -> create a free API key
JINA_API_KEY=your_jina_key_here
JINA_BASE_URL=https://api.jina.ai/v1
JINA_EMBED_MODEL=jina-embeddings-v3
JINA_EMBED_DIMS=1024
# Asymmetric retrieval tasks — better question answering. Leave as-is.
JINA_TASK_PASSAGE=retrieval.passage
JINA_TASK_QUERY=retrieval.query

# --- Vector store (Qdrant Cloud — free tier, permanent, no card) ----
# https://cloud.qdrant.io  -> create a free cluster, copy URL + API key
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_key_here
QDRANT_COLLECTION=website_kb
# Set to 1 only for local/offline development (in-memory, no account).
QDRANT_LOCAL=0

# --- Knowledge base -------------------------------------------------
# Master switch. When false, /api/chat falls back to plain LLM conversation.
KB_ENABLED=true
# Folder holding your .md / .txt / .json / .pdf knowledge files.
KB_SOURCE_DIR=knowledge_base
KB_CHUNK_SIZE=600
KB_CHUNK_OVERLAP=100
KB_TOP_K=4
# Cosine similarity floor. Real Jina embeddings: 0.5 is a good default.
KB_MIN_SCORE=0.5
KB_MAX_CONTEXT_CHARS=4000
# Optional: protects POST /kb/rebuild. Leave empty to allow it (local dev only).
KB_ADMIN_TOKEN=

# --- Widget / security ----------------------------------------------
# Comma-separated list of origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=20
MAX_BODY_BYTES=8192
MAX_INPUT_CHARS=2000
MAX_HISTORY_MESSAGES=10
MAX_OUTPUT_TOKENS=512

# --- Server ----------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- Optional: PDF ingestion needs pypdf -----------------------------
# pip install pypdf
